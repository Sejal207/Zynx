# ==========================================
# Zynx UX Intelligence Platform Configuration
# ==========================================

# Provide at least one API key:
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom API Base (leave blank for defaults)
# GROQ_API_BASE=

# Optional: Local Ollama settings (for local CLI evaluation)
# OLLAMA_BASE_URL=http://localhost:11434

# Required for Human + Think-Aloud mode (Phase 2) -- Sarvam Speech-to-Text.
# Without this, Autonomous Agent mode is unaffected; Think-Aloud transcription
# will return a clear "not configured" error instead of a crash.
SARVAM_API_KEY=your_sarvam_api_key_here
